# Copy to .env for local runs. On AWS these come from the launch template user-data.
APP_ENV=local
DATABASE_URL=mysql+pymysql://feastflow:feastflow@mysql:3306/feastflow
JWT_SECRET=change-me
AWS_REGION=us-east-1
# Set only for LocalStack; leave empty on AWS so boto3 uses LabRole credentials.
AWS_ENDPOINT_URL=http://localstack:4566
SQS_PRIME_QUEUE=orders-prime
SQS_STANDARD_QUEUE=orders-standard
SNS_TOPIC_NAME=order-notifications
S3_BUCKET=feastflow-assets
