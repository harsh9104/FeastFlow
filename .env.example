# Copy to .env for local runs. On AWS these come from the launch template user-data.
APP_ENV=local
DATABASE_URL=mysql+pymysql://feastflow:feastflow@mysql:3306/feastflow
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=120
# Seeded on every start if missing. Change both before deploying to AWS.
ADMIN_EMAIL=admin@feastflow.app
ADMIN_PASSWORD=Admin@12345
PRIME_PLAN_DAYS=30
AWS_REGION=us-east-1
# Set only for LocalStack; leave empty on AWS so boto3 uses LabRole credentials.
AWS_ENDPOINT_URL=http://localstack:4566
SQS_PRIME_QUEUE=orders-prime
SQS_STANDARD_QUEUE=orders-standard
SNS_TOPIC_NAME=order-notifications
S3_BUCKET=feastflow-assets
# Local only: presign image URLs for the browser's view of LocalStack.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
# Upload placeholder food images for menu items that have none.
SEED_IMAGES=true
SNS_EMAIL_SUBSCRIPTIONS=true

# Worker: simulated kitchen and delivery timings (seconds)
CONFIRM_SECONDS=2
PREP_SECONDS=20
DELIVERY_SECONDS=40
AGING_SECONDS=120

# Festival-day load testing
LOADTEST_USERS=200
LOADTEST_PRIME_PERCENT=30
# Password for the seeded load-test customers (Locust logs in with it). Fine to set
# locally; on AWS use a long random value, or leave empty to lock those accounts.
LOADTEST_PASSWORD=Festival-local-only-1
# Locust web API (docker compose --profile loadtest up). On AWS: http://<locust-private-ip>:8089
LOCUST_URL=http://locust:8089
